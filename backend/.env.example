# ==========================================
# DamMeManga Backend Environment Variables
# ==========================================

# Server Port
PORT=8080

# Database Configuration (MySQL / TiDB Cloud)
DB_URL=jdbc:mysql://localhost:3306/dammemanga?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=your_db_password

# JWT Authentication
JWT_SECRET=YourSuperSecretKeyWithAtLeast32CharactersLong123456
JWT_EXPIRATION_MS=86400000

# ImgBB API Key (Upload cover and chapter images)
IMGBB_API_KEY=your_imgbb_api_key
